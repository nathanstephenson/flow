{
  "name": "goodharness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "goodharness": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "spike:auth": "node --experimental-strip-types spikes/subscription-auth.ts",
    "start": "node --experimental-strip-types src/cli/main.ts",
    "spike:adapter": "node --experimental-strip-types spikes/adapter-smoke.ts",
    "build:assets": "node scripts/build-assets.mjs",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@earendil-works/pi-coding-agent": "^0.75.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild-wasm": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3"
  }
}
