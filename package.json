{
  "name": "@nathanstephenson/flow",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanstephenson/flow.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "flow": "./dist/cli/bootstrap.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "build/workflow-runtime.cjs"
  ],
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "prepack": "npm run build && npm run build:web && npm run build:workflow-runtime",
    "test:package": "node scripts/test-package.mjs",
    "build:workflow-runtime": "node scripts/build-workflow-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.presentation.json && tsc -p web/tsconfig.json --noEmit && tsc -p web/tsconfig.node.json --noEmit",
    "dev": "vite --config web/vite.config.ts",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\" \"web/**/*.test.ts\"",
    "spike:auth": "node --experimental-strip-types spikes/subscription-auth.ts",
    "test:oidc-issuer": "node --experimental-strip-types scripts/test-oidc-issuer.ts",
    "prestart": "npm run build:web && npm run build:workflow-runtime",
    "start": "node --experimental-strip-types src/cli/main.ts",
    "spike:adapter": "node --experimental-strip-types spikes/adapter-smoke.ts",
    "build:web": "node scripts/build-web.mjs",
    "prebuild:binary": "npm run build:web",
    "build:binary": "node --experimental-strip-types scripts/build-binary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@codemirror/lang-javascript": "^6.2.5",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "^6.2.12",
    "marked": "^18.0.11",
    "node-pty": "^1.1.0",
    "openid-client": "^6.8.8",
    "quickjs-emscripten": "^0.32.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/oidc-provider": "^9.12.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.39.0",
    "oidc-provider": "^9.12.2",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.2"
  }
}
