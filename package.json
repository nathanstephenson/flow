{
  "name": "goodharness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "goodharness": "./dist/cli/main.js"
  },
  "scripts": {
    "prebuild": "npm run build:assets",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.presentation.json && tsc -p web/tsconfig.json --noEmit && tsc -p web/tsconfig.node.json --noEmit",
    "dev": "vite --config web/vite.config.ts",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\" \"web/**/*.test.ts\"",
    "spike:auth": "node --experimental-strip-types spikes/subscription-auth.ts",
    "start": "node --experimental-strip-types src/cli/main.ts",
    "spike:adapter": "node --experimental-strip-types spikes/adapter-smoke.ts",
    "build:assets": "node scripts/build-web.mjs",
    "prebuild:binary": "npm run build:assets",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@earendil-works/pi-coding-agent": "^0.75.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.39.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
