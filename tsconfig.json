{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  // web/ is deliberately absent. The web app's presentation logic still gets checked under these
  // options — see tsconfig.presentation.json, which extends this file with noEmit — but including it
  // here would emit dead dist/web/** output, since this program is rootDir: "." with declaration.
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "spikes/**/*.ts"
  ]
}
